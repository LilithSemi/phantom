    @Override public void onCreate(Bundle state) {
        super.onCreate(state);
        createNotificationChannel();
@START_BACKGROUND_SERVICE@
@START_SYSTEM_SHELL_SERVICE@
        phantomView = new PhantomView(this);
        setContentView(phantomView);
        configureSystemUi();
        pumpPlatform(this);
        if (Build.VERSION.SDK_INT >= 33) {
            getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
                    OnBackInvokedDispatcher.PRIORITY_DEFAULT, this::handleBack);
        }
    }

    static void pumpPlatform(Context context) {
        long now = android.os.SystemClock.uptimeMillis();
        if (now >= nextPlatformRefresh) {
            nextPlatformRefresh = now + 2000;
            pushApplications(context);
            pushConnectivity(context);
            pushWifiNetworks(context);
            pushBluetooth();
            pushPower(context);
            pushAudio(context);
            pushBrightness(context);
            pushIdentity(context);
        }
        drainSystemAction(context);
    }

    private static void pushApplications(Context context) {
        PackageManager pm = context.getPackageManager();
        Intent query = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
        List<ResolveInfo> apps = pm.queryIntentActivities(query, PackageManager.MATCH_ALL);
        apps.removeIf(info -> info.activityInfo == null || info.activityInfo.packageName.equals(context.getPackageName()));
        Collections.sort(apps, new ResolveInfo.DisplayNameComparator(pm));
        Map<String, ActivityManager.RunningTaskInfo> runningTasks = runningTasks(context);
        if (nativeBeginApplications(apps.size()) == 0) return;
        for (int i = 0; i < apps.size(); ++i) {
            ResolveInfo info = apps.get(i);
            String id = info.activityInfo.packageName + "/" + info.activityInfo.name;
            CharSequence label = info.loadLabel(pm);
            ActivityManager.RunningTaskInfo task = runningTasks.get(info.activityInfo.packageName);
            putApplication(pm, info, i, id,
                    label == null ? info.activityInfo.packageName : label.toString(), task);
        }
    }

    private static void putApplication(PackageManager pm, ResolveInfo info, int index, String id,
            String name, ActivityManager.RunningTaskInfo task) {
        byte[] idBytes = id.getBytes(StandardCharsets.UTF_8);
        byte[] nameBytes = name.getBytes(StandardCharsets.UTF_8);
        byte[] iconBytes = applicationIcons.computeIfAbsent(id, key -> encodeIcon(pm, info));
        byte[] previewBytes = task == null ? new byte[0] : encodeTaskPreview(task.id);
        if (nativeBeginApplication(index, idBytes.length, nameBytes.length, iconBytes.length,
                previewBytes.length, task == null ? 0 : 1) == 0) return;
        putApplicationBytes(index, 0, idBytes);
        putApplicationBytes(index, 1, nameBytes);
        putApplicationBytes(index, 2, iconBytes);
        putApplicationBytes(index, 3, previewBytes);
    }

    private static void putApplicationBytes(int index, int field, byte[] bytes) {
        for (int i = 0; i < bytes.length; ++i) nativeApplicationByte(index, field, i, bytes[i] & 0xff);
    }

    private static byte[] encodeIcon(PackageManager pm, ResolveInfo info) {
        try {
            Drawable icon = info.loadIcon(pm);
            if (icon == null) return new byte[0];
            Bitmap bitmap = Bitmap.createBitmap(96, 96, Bitmap.Config.ARGB_8888);
            Canvas canvas = new Canvas(bitmap);
            icon.setBounds(0, 0, 96, 96);
            icon.draw(canvas);
            byte[] bytes = encodePng(bitmap);
            bitmap.recycle();
            return bytes;
        } catch (RuntimeException ignored) { }
        return new byte[0];
    }

    @SuppressWarnings("deprecation")
    private static Map<String, ActivityManager.RunningTaskInfo> runningTasks(Context context) {
        Map<String, ActivityManager.RunningTaskInfo> result = new HashMap<>();
        try {
            ActivityManager manager = context.getSystemService(ActivityManager.class);
            for (ActivityManager.RunningTaskInfo task : manager.getRunningTasks(64)) {
                ComponentName component = task.topActivity != null ? task.topActivity : task.baseActivity;
                if (component != null && !component.getPackageName().equals(context.getPackageName())) {
                    result.putIfAbsent(component.getPackageName(), task);
                }
            }
        } catch (RuntimeException ignored) { }
        return result;
    }

    private static byte[] encodeTaskPreview(int taskId) {
        Object snapshot = null;
        Bitmap hardware = null;
        Bitmap software = null;
        Bitmap scaled = null;
        try {
            Class<?> managerClass = Class.forName("android.window.TaskSnapshotManager");
            Object manager = managerClass.getMethod("getInstance").invoke(null);
            snapshot = managerClass.getMethod("getTaskSnapshot", int.class, int.class)
                    .invoke(manager, taskId, 2);
            if (snapshot == null) return new byte[0];
            hardware = (Bitmap)snapshot.getClass().getMethod("wrapToBitmap").invoke(snapshot);
            if (hardware == null) return new byte[0];
            software = hardware.copy(Bitmap.Config.ARGB_8888, false);
            if (software == null) return new byte[0];
            int width = Math.min(360, software.getWidth());
            int height = Math.max(1, Math.round(software.getHeight()
                    * (width / (float)Math.max(1, software.getWidth()))));
            scaled = Bitmap.createScaledBitmap(software, width, height, true);
            return encodePng(scaled);
        } catch (ReflectiveOperationException | RuntimeException ignored) {
            return new byte[0];
        } finally {
            if (scaled != null && scaled != software) scaled.recycle();
            if (software != null) software.recycle();
            if (snapshot != null) try {
                snapshot.getClass().getMethod("closeBuffer").invoke(snapshot);
            } catch (ReflectiveOperationException | RuntimeException ignored) { }
        }
    }

    private static byte[] encodePng(Bitmap bitmap) {
        ByteArrayOutputStream output = new ByteArrayOutputStream();
        bitmap.compress(Bitmap.CompressFormat.PNG, 100, output);
        return output.toByteArray();
    }

    private static void pushAudio(Context context) {
        AudioManager manager = context.getSystemService(AudioManager.class);
        if (manager == null) return;
        int maximum = manager.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
        nativePlatformAudio(
                manager.getStreamVolume(AudioManager.STREAM_MUSIC),
                maximum,
                manager.isStreamMute(AudioManager.STREAM_MUSIC) ? 1 : 0);
    }

    private static void pushBrightness(Context context) {
        try {
            DisplayManager manager = context.getSystemService(DisplayManager.class);
            if (manager == null) return;
            float value = (float)manager.getClass()
                    .getMethod("getBrightness", int.class)
                    .invoke(manager, Display.DEFAULT_DISPLAY);
            if (Float.isFinite(value) && value >= 0) nativePlatformBrightness(value);
        } catch (ReflectiveOperationException | RuntimeException ignored) { }
    }

    private static void pushIdentity(Context context) {
        UserManager manager = context.getSystemService(UserManager.class);
        if (manager == null) return;
        try {
            String userName = manager.getUserName();
            if (userName == null || userName.isEmpty()) userName = "User";
            String release = Build.VERSION.RELEASE;
            String systemName = release == null || release.isEmpty()
                    ? "Android API " + Build.VERSION.SDK_INT
                    : "Android " + release;
            byte[][] fields = {
                    userName.getBytes(StandardCharsets.UTF_8),
                    userName.getBytes(StandardCharsets.UTF_8),
                    systemName.getBytes(StandardCharsets.UTF_8),
            };
            if (nativeBeginIdentity(fields[0].length, fields[1].length, fields[2].length) == 0) return;
            for (int field = 0; field < fields.length; ++field) {
                for (int offset = 0; offset < fields[field].length; ++offset) {
                    nativeIdentityByte(field, offset, fields[field][offset] & 0xff);
                }
            }
        } catch (SecurityException ignored) { }
    }

    private static void pushConnectivity(Context context) {
        ConnectivityManager manager = context.getSystemService(ConnectivityManager.class);
        WifiManager wifi = context.getSystemService(WifiManager.class);
        Network active = manager == null ? null : manager.getActiveNetwork();
        NetworkCapabilities caps = active == null || manager == null ? null : manager.getNetworkCapabilities(active);
        int transport = 0;
        if (caps != null) {
            if (caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)) transport = 2;
            else if (caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)) transport = 3;
            else if (caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)) transport = 1;
        }
        int reachability = caps == null ? 0 : caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED) ? 3
                : caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) ? 2 : 1;
        int strength = -1;
        if (transport == 2 && wifi != null) {
            try { strength = WifiManager.calculateSignalLevel(wifi.getConnectionInfo().getRssi(), 101); }
            catch (SecurityException ignored) {}
        }
        int flags = active != null ? 1 : 0;
        if (wifi != null && wifi.isWifiEnabled()) flags |= 2;
        boolean cellularAvailable = context.getPackageManager().hasSystemFeature(PackageManager.FEATURE_TELEPHONY);
        if (cellularAvailable) flags |= 4;
        if (cellularAvailable) {
            TelephonyManager telephony = context.getSystemService(TelephonyManager.class);
            try { if (telephony != null && telephony.isDataEnabled()) flags |= 8; }
            catch (SecurityException ignored) { if (transport == 3) flags |= 8; }
        }
        nativePlatformConnectivity(transport, reachability, strength, flags);
    }

    private static void pushBluetooth() {
        BluetoothAdapter adapter = BluetoothAdapter.getDefaultAdapter();
        if (adapter == null) { nativePlatformBluetooth(0, 0, 0); return; }
        try {
            int flags = 1 | (adapter.isEnabled() ? 2 : 0) | (adapter.isDiscovering() ? 4 : 0);
            int paired = adapter.getBondedDevices().size();
            nativePlatformBluetooth(flags, 0, paired);
        } catch (SecurityException ignored) { nativePlatformBluetooth(1, 0, 0); }
    }

    private static void pushPower(Context context) {
        BatteryManager manager = context.getSystemService(BatteryManager.class);
        Intent battery = context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
        int present = battery == null || battery.getBooleanExtra(BatteryManager.EXTRA_PRESENT, true) ? 1 : 0;
        int status = battery == null ? BatteryManager.BATTERY_STATUS_UNKNOWN
                : battery.getIntExtra(BatteryManager.EXTRA_STATUS, BatteryManager.BATTERY_STATUS_UNKNOWN);
        int level = battery == null ? -1 : battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
        int scale = battery == null ? -1 : battery.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
        int percent = level >= 0 && scale > 0 ? Math.round(level * 100.0f / scale) : -1;
        if (percent < 0 && manager != null) {
            percent = manager.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY);
        }
        long timeFull = -1;
        if (manager != null && Build.VERSION.SDK_INT >= 28 && status == BatteryManager.BATTERY_STATUS_CHARGING) {
            timeFull = manager.computeChargeTimeRemaining();
        }
        nativePlatformPower(present, Math.max(0, Math.min(percent, 100)), status, -1, timeFull);
    }

    @SuppressWarnings("deprecation")
    private static void pushWifiNetworks(Context context) {
        WifiManager wifi = context.getSystemService(WifiManager.class);
        if (wifi == null) { nativeBeginWifiNetworks(0); return; }
        try {
            List<ScanResult> results = wifi.getScanResults();
            if (nativeBeginWifiNetworks(results.size()) == 0) return;
            String connected = wifi.getConnectionInfo().getBSSID();
            for (int i = 0; i < results.size(); ++i) {
                ScanResult result = results.get(i);
                String id = result.BSSID == null ? result.SSID : result.BSSID;
                String ssid = result.SSID == null ? "" : result.SSID;
                byte[] idBytes = id.getBytes(StandardCharsets.UTF_8);
                byte[] ssidBytes = ssid.getBytes(StandardCharsets.UTF_8);
                int strength = WifiManager.calculateSignalLevel(result.level, 101);
                String capabilities = result.capabilities == null ? "" : result.capabilities;
                boolean secured = capabilities.contains("WEP") || capabilities.contains("WPA")
                        || capabilities.contains("SAE") || capabilities.contains("EAP");
                if (nativeBeginWifiNetwork(i, idBytes.length, ssidBytes.length, strength,
                        secured ? 1 : 0, id.equals(connected) ? 1 : 0) == 0) continue;
                for (int n = 0; n < idBytes.length; ++n) nativeWifiNetworkByte(i, 0, n, idBytes[n] & 0xff);
                for (int n = 0; n < ssidBytes.length; ++n) nativeWifiNetworkByte(i, 1, n, ssidBytes[n] & 0xff);
            }
        } catch (RuntimeException ignored) { nativeBeginWifiNetworks(0); }
    }

    private static ScanResult findWifi(Context context, String id) {
        WifiManager wifi = context.getSystemService(WifiManager.class);
        if (wifi == null) return null;
        for (ScanResult result : wifi.getScanResults()) {
            if (id.equals(result.BSSID) || id.equals(result.SSID)) return result;
        }
        return null;
    }

    private static String wifiQuoted(String value) { return "\"" + value.replace("\"", "\\\"") + "\""; }

    private static String platformActionText() {
        int length = nativePlatformActionTextLength();
        if (length < 0) return "";
        byte[] bytes = new byte[length];
        for (int i = 0; i < length; ++i) bytes[i] = (byte)nativePlatformActionTextByte(i);
        return new String(bytes, StandardCharsets.UTF_8);
    }

    @SuppressWarnings("deprecation")
    private static void drainSystemAction(Context context) {
        int action = nativeTakePlatformAction();
        if (action == 0) return;
        String value = platformActionText();
        try {
            switch (action) {
                case 1: {
                    ComponentName component = ComponentName.unflattenFromString(value);
                    if (component != null) context.startActivity(new Intent().setComponent(component)
                            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT));
                    break;
                }
                case 2: context.getSystemService(WifiManager.class).setWifiEnabled(nativePlatformActionValue() != 0); break;
                case 3: { BluetoothAdapter a = BluetoothAdapter.getDefaultAdapter(); if (a != null) { if (nativePlatformActionValue() != 0) a.enable(); else a.disable(); } break; }
                case 4: { BluetoothAdapter a = BluetoothAdapter.getDefaultAdapter(); if (a != null) a.startDiscovery(); break; }
                case 5: PhantomNotificationListener.dismiss(value); break;
                case 6: PhantomNotificationListener.clearAll(); break;
                case 7: PhantomNotificationListener.invoke(value); break;
                case 8: context.getSystemService(WifiManager.class).startScan(); break;
                case 9: {
                    int separator = value.indexOf('\0');
                    String id = separator < 0 ? value : value.substring(0, separator);
                    String password = separator < 0 ? "" : value.substring(separator + 1);
                    ScanResult result = findWifi(context, id);
                    WifiManager wifi = context.getSystemService(WifiManager.class);
                    if (result != null && wifi != null) {
                        WifiConfiguration config = new WifiConfiguration();
                        config.SSID = wifiQuoted(result.SSID);
                        config.BSSID = result.BSSID;
                        if (password.isEmpty()) config.allowedKeyManagement.set(WifiConfiguration.KeyMgmt.NONE);
                        else config.preSharedKey = wifiQuoted(password);
                        int networkId = wifi.addNetwork(config);
                        if (networkId >= 0) wifi.enableNetwork(networkId, true);
                    }
                    break;
                }
                case 10: context.getSystemService(WifiManager.class).disconnect(); break;
                case 11: {
                    TelephonyManager telephony = context.getSystemService(TelephonyManager.class);
                    if (telephony != null) telephony.setDataEnabled(nativePlatformActionValue() != 0);
                    break;
                }
                case 12: {
                    AudioManager audio = context.getSystemService(AudioManager.class);
                    if (audio == null) break;
                    int maximum = audio.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
                    int volume = Math.round(Math.max(0, Math.min(1, nativePlatformActionNumber())) * maximum);
                    audio.setStreamVolume(AudioManager.STREAM_MUSIC, volume, 0);
                    audio.adjustStreamVolume(
                            AudioManager.STREAM_MUSIC,
                            nativePlatformActionValue() != 0
                                    ? AudioManager.ADJUST_MUTE
                                    : AudioManager.ADJUST_UNMUTE,
                            0);
                    break;
                }
                case 13: {
                    DisplayManager display = context.getSystemService(DisplayManager.class);
                    if (display != null) display.getClass()
                            .getMethod("setBrightness", int.class, float.class)
                            .invoke(display, Display.DEFAULT_DISPLAY,
                                    Math.max(0, Math.min(1, nativePlatformActionNumber())));
                    break;
                }
                default: break;
            }
        } catch (ReflectiveOperationException | RuntimeException ignored) { }
    }

    @Override protected void onPause() {
        if (phantomView != null) {
            phantomView.setPaused(true);
            if (phantomView.handle != 0) nativeLifecycle(phantomView.handle, 0);
        }
        super.onPause();
    }

    @Override protected void onResume() {
        super.onResume();
        if (IMMERSIVE) hideSystemBars();
        if (phantomView != null) {
            if (phantomView.handle != 0) nativeLifecycle(phantomView.handle, 1);
            phantomView.setPaused(false);
        }
    }

    @Override protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        if (Intent.ACTION_MAIN.equals(intent.getAction())
                && intent.hasCategory(Intent.CATEGORY_HOME)) {
            nativeHomeActivated(intent.getIntExtra("org.phantomui.extra.SHELL_ACTION", 0));
            if (phantomView != null) phantomView.scheduleFrame();
        }
    }

    @SuppressWarnings("deprecation")
    private void configureSystemUi() {
        Window window = getWindow();
        window.setStatusBarColor(Color.TRANSPARENT);
        window.setNavigationBarColor(Color.TRANSPARENT);
        if (Build.VERSION.SDK_INT >= 30) {
            window.setDecorFitsSystemWindows(false);
        } else {
            int flags = View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                    | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                    | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION;
            window.getDecorView().setSystemUiVisibility(flags);
        }
        if (IMMERSIVE) hideSystemBars();
    }

    @SuppressWarnings("deprecation")
    private void hideSystemBars() {
        Window window = getWindow();
        if (Build.VERSION.SDK_INT >= 30) {
            WindowInsetsController controller = window.getInsetsController();
            if (controller == null) return;
            controller.setSystemBarsBehavior(
                    WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
            controller.hide(WindowInsets.Type.systemBars());
        } else {
            window.getDecorView().setSystemUiVisibility(
                    View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                            | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                            | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                            | View.SYSTEM_UI_FLAG_FULLSCREEN
                            | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                            | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
        }
    }

    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT < 26) return;
        getSystemService(NotificationManager.class).createNotificationChannel(
                new NotificationChannel(NOTIFICATION_CHANNEL_ID, NOTIFICATION_CHANNEL_NAME, NotificationManager.IMPORTANCE_DEFAULT));
    }

    private int notificationPermission() {
        if (Build.VERSION.SDK_INT < 33) return 0;
        return checkSelfPermission("android.permission.POST_NOTIFICATIONS") == android.content.pm.PackageManager.PERMISSION_GRANTED ? 0 : 2;
    }

    @Override public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] results) {
        super.onRequestPermissionsResult(requestCode, permissions, results);
        if (requestCode == 71 && phantomView != null && phantomView.handle != 0) {
            int result = results.length > 0 && results[0] == android.content.pm.PackageManager.PERMISSION_GRANTED ? 0 : 1;
            nativeNotificationPermission(phantomView.handle, result);
        }
    }

    @Override protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (requestCode != 72 || phantomView == null || phantomView.handle == 0) return;
        if (resultCode != RESULT_OK || data == null || data.getData() == null) {
            nativeFinishFilePicker(phantomView.handle, 1);
            return;
        }
        Uri uri = data.getData();
        try {
            String name = "file";
            try (Cursor cursor = getContentResolver().query(uri, new String[]{android.provider.OpenableColumns.DISPLAY_NAME}, null, null, null)) {
                if (cursor != null && cursor.moveToFirst()) {
                    int column = cursor.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME);
                    if (column >= 0 && cursor.getString(column) != null) name = cursor.getString(column);
                }
            }
            String type = getContentResolver().getType(uri);
            if (type == null) type = "application/octet-stream";
            ByteArrayOutputStream output = new ByteArrayOutputStream();
            try (InputStream input = getContentResolver().openInputStream(uri)) {
                if (input == null) throw new java.io.IOException("no stream");
                byte[] chunk = new byte[16384];
                for (int count; (count = input.read(chunk)) >= 0;) output.write(chunk, 0, count);
            }
            phantomView.deliverFile(name, type, output.toByteArray());
        } catch (Exception ignored) {
            nativeFinishFilePicker(phantomView.handle, 2);
        }
    }

    @Override public boolean dispatchKeyEvent(KeyEvent event) {
        if (HOME_SCREEN && (event.getKeyCode() == KeyEvent.KEYCODE_MENU
                || event.getKeyCode() == KeyEvent.KEYCODE_APP_SWITCH)) {
            if (event.getAction() == KeyEvent.ACTION_DOWN && event.getRepeatCount() == 0) {
                nativeHomeActivated(1);
                if (phantomView != null) phantomView.scheduleFrame();
            }
            return true;
        }
        if (phantomView != null && phantomView.handle != 0) {
            int action;
            if (event.getAction() == KeyEvent.ACTION_UP) action = 2;
            else if (event.getRepeatCount() > 0) action = 1;
            else action = 0;
            int modifiers = (event.isShiftPressed() ? 1 : 0)
                    | (event.isCtrlPressed() ? 2 : 0)
                    | (event.isAltPressed() ? 4 : 0)
                    | (event.isMetaPressed() ? 8 : 0);
            // Keep Shift/Caps in the produced symbol, but remove shortcut
            // modifiers: Ctrl+C is the `c` keysym with Ctrl held, not U+0003.
            int unicodeMeta = event.getMetaState()
                    & ~(KeyEvent.META_CTRL_MASK | KeyEvent.META_ALT_MASK | KeyEvent.META_META_MASK);
            int codepoint = event.getUnicodeChar(unicodeMeta);
            if (nativeKey(phantomView.handle, androidKeysym(event.getKeyCode()), codepoint, modifiers, action) != 0) {
                phantomView.scheduleFrame();
                return true;
            }
        }
        return super.dispatchKeyEvent(event);
    }

    @SuppressWarnings("deprecation")
    @Override public void onBackPressed() {
        if (handleBack()) return;
        if (Build.VERSION.SDK_INT < 33) super.onBackPressed();
    }

    private boolean handleBack() {
        if (phantomView != null && phantomView.handle != 0
                && nativeKey(phantomView.handle, 0xff1b, 0, 0, 0) != 0) {
            nativeKey(phantomView.handle, 0xff1b, 0, 0, 2);
            phantomView.scheduleFrame();
            return true;
        }
        if (Build.VERSION.SDK_INT >= 33) finishAfterTransition();
        return false;
    }

    /** X11 keysyms are Phantom's platform-neutral named-key representation. */
    private static int androidKeysym(int keyCode) {
        switch (keyCode) {
            case KeyEvent.KEYCODE_BACK: return 0xff1b;
            case KeyEvent.KEYCODE_DEL: return 0xff08;
            case KeyEvent.KEYCODE_TAB: return 0xff09;
            case KeyEvent.KEYCODE_ENTER:
            case KeyEvent.KEYCODE_NUMPAD_ENTER: return 0xff0d;
            case KeyEvent.KEYCODE_ESCAPE: return 0xff1b;
            case KeyEvent.KEYCODE_MOVE_HOME: return 0xff50;
            case KeyEvent.KEYCODE_DPAD_LEFT: return 0xff51;
            case KeyEvent.KEYCODE_DPAD_UP: return 0xff52;
            case KeyEvent.KEYCODE_DPAD_RIGHT: return 0xff53;
            case KeyEvent.KEYCODE_DPAD_DOWN: return 0xff54;
            case KeyEvent.KEYCODE_PAGE_UP: return 0xff55;
            case KeyEvent.KEYCODE_PAGE_DOWN: return 0xff56;
            case KeyEvent.KEYCODE_MOVE_END: return 0xff57;
            case KeyEvent.KEYCODE_INSERT: return 0xff63;
            case KeyEvent.KEYCODE_FORWARD_DEL: return 0xffff;
            case KeyEvent.KEYCODE_SHIFT_LEFT: return 0xffe1;
            case KeyEvent.KEYCODE_SHIFT_RIGHT: return 0xffe2;
            case KeyEvent.KEYCODE_CTRL_LEFT: return 0xffe3;
            case KeyEvent.KEYCODE_CTRL_RIGHT: return 0xffe4;
            case KeyEvent.KEYCODE_ALT_LEFT: return 0xffe9;
            case KeyEvent.KEYCODE_ALT_RIGHT: return 0xffea;
            case KeyEvent.KEYCODE_META_LEFT: return 0xffeb;
            case KeyEvent.KEYCODE_META_RIGHT: return 0xffec;
            case KeyEvent.KEYCODE_F1: return 0xffbe;
            case KeyEvent.KEYCODE_F2: return 0xffbf;
            case KeyEvent.KEYCODE_F3: return 0xffc0;
            case KeyEvent.KEYCODE_F4: return 0xffc1;
            case KeyEvent.KEYCODE_F5: return 0xffc2;
            case KeyEvent.KEYCODE_F6: return 0xffc3;
            case KeyEvent.KEYCODE_F7: return 0xffc4;
            case KeyEvent.KEYCODE_F8: return 0xffc5;
            case KeyEvent.KEYCODE_F9: return 0xffc6;
            case KeyEvent.KEYCODE_F10: return 0xffc7;
            case KeyEvent.KEYCODE_F11: return 0xffc8;
            case KeyEvent.KEYCODE_F12: return 0xffc9;
            default: return 0;
        }
    }

    private static final class PhantomView extends SurfaceView implements SurfaceHolder.Callback, Choreographer.FrameCallback {
        private long handle;
        private boolean surfaceAttached;
        private boolean frameScheduled;
        private boolean paused;
        private boolean imeEnabled;

        PhantomView(Context context) {
            super(context);
            byte[] filesDir = context.getFilesDir().getAbsolutePath().getBytes(StandardCharsets.UTF_8);
            if (nativeBeginFilesDir(filesDir.length) != 0) {
                for (int i = 0; i < filesDir.length; ++i) nativeFilesDirByte(i, filesDir[i] & 0xff);
            }
            getHolder().addCallback(this);
            setFocusable(true);
            setFocusableInTouchMode(true);
            setClickable(true);
        }

        @Override public void surfaceCreated(SurfaceHolder holder) {
            Rect frame = holder.getSurfaceFrame();
            int width = frame.width();
            int height = frame.height();
            if (width == 0 || height == 0) return;
            float density = getResources().getDisplayMetrics().density;
            float fontScale = getResources().getConfiguration().fontScale;
            Rect insets = systemBarInsets();
            if (handle == 0) handle = nativeCreate(0, width, height, density, fontScale, insets.left, insets.top, insets.right, insets.bottom, ((MainActivity)getContext()).notificationPermission());
            surfaceAttached = handle != 0 && nativeSurfaceCreated(handle, holder.getSurface(), width, height, density) != 0;
            scheduleFrame();
        }

        @Override public void surfaceChanged(SurfaceHolder holder, int format, int width, int height) {
            scheduleFrame();
        }

        @Override public void surfaceDestroyed(SurfaceHolder holder) {
            surfaceAttached = false;
            if (frameScheduled) Choreographer.getInstance().removeFrameCallback(this);
            frameScheduled = false;
            if (handle != 0) nativeSurfaceDestroyed(handle);
        }

        @Override public void doFrame(long frameNanos) {
            frameScheduled = false;
            if (!surfaceAttached || handle == 0) return;
            MainActivity.pumpPlatform(getContext());
            Rect insets = systemBarInsets();
            nativeRender(
                    handle,
                    getWidth(),
                    getHeight(),
                    getResources().getDisplayMetrics().density,
                    getResources().getConfiguration().fontScale,
                    insets.left,
                    insets.top,
                    insets.right,
                    insets.bottom,
                    frameNanos);
            drainPlatformRequests();
            scheduleFrame();
        }

        private void scheduleFrame() {
            if (!surfaceAttached || frameScheduled || paused) return;
            frameScheduled = true;
            Choreographer.getInstance().postFrameCallback(this);
        }

        private void setPaused(boolean value) {
            paused = value;
            if (paused && frameScheduled) {
                Choreographer.getInstance().removeFrameCallback(this);
                frameScheduled = false;
            } else if (!paused) {
                scheduleFrame();
            }
        }

        @SuppressWarnings("deprecation")
        private Rect systemBarInsets() {
            WindowInsets windowInsets;
            if (Build.VERSION.SDK_INT >= 30) {
                WindowManager manager = getContext().getSystemService(WindowManager.class);
                WindowMetrics metrics = manager.getCurrentWindowMetrics();
                windowInsets = metrics.getWindowInsets();
                int types = WindowInsets.Type.displayCutout();
                if (!IMMERSIVE) {
                    types |= WindowInsets.Type.statusBars() | WindowInsets.Type.navigationBars();
                }
                Insets value = windowInsets.getInsetsIgnoringVisibility(types);
                return new Rect(value.left, value.top, value.right, value.bottom);
            }
            windowInsets = getRootWindowInsets();
            if (windowInsets == null) return new Rect();
            if (IMMERSIVE) {
                if (Build.VERSION.SDK_INT < 28 || windowInsets.getDisplayCutout() == null) return new Rect();
                android.view.DisplayCutout cutout = windowInsets.getDisplayCutout();
                return new Rect(cutout.getSafeInsetLeft(), cutout.getSafeInsetTop(),
                        cutout.getSafeInsetRight(), cutout.getSafeInsetBottom());
            }
            return new Rect(
                    windowInsets.getSystemWindowInsetLeft(),
                    windowInsets.getSystemWindowInsetTop(),
                    windowInsets.getSystemWindowInsetRight(),
                    windowInsets.getSystemWindowInsetBottom());
        }

        @Override public boolean onTouchEvent(MotionEvent event) {
            if (handle == 0) return true;
            int action = event.getActionMasked();
            if (action == MotionEvent.ACTION_MOVE) {
                for (int i = 0; i < event.getPointerCount(); ++i) {
                    nativeTouch(handle, 1, event.getPointerId(i), event.getX(i), event.getY(i));
                }
            } else if (action == MotionEvent.ACTION_CANCEL) {
                for (int i = 0; i < event.getPointerCount(); ++i) {
                    nativeTouch(handle, 3, event.getPointerId(i), event.getX(i), event.getY(i));
                }
            } else if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN
                    || action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_POINTER_UP) {
                int index = event.getActionIndex();
                int translated = (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN) ? 0 : 2;
                boolean wantsIme = nativeTouch(handle, translated, event.getPointerId(index), event.getX(index), event.getY(index)) != 0;
                if (translated == 0) updateIme(wantsIme);
                if (action == MotionEvent.ACTION_UP) performClick();
            }
            drainPlatformRequests();
            scheduleFrame();
            return true;
        }

        @Override public boolean onGenericMotionEvent(MotionEvent event) {
            if (handle == 0 || (event.getSource() & InputDevice.SOURCE_CLASS_POINTER) == 0) {
                return super.onGenericMotionEvent(event);
            }
            int action = event.getActionMasked();
            if (action == MotionEvent.ACTION_HOVER_MOVE || action == MotionEvent.ACTION_MOVE) {
                nativePointerMove(handle, event.getX(), event.getY());
                scheduleFrame();
                return true;
            }
            if (action == MotionEvent.ACTION_SCROLL) {
                float step = 48.0f * getResources().getDisplayMetrics().density;
                nativePointerScroll(handle, event.getX(), event.getY(),
                        -event.getAxisValue(MotionEvent.AXIS_HSCROLL) * step,
                        -event.getAxisValue(MotionEvent.AXIS_VSCROLL) * step);
                scheduleFrame();
                return true;
            }
            return super.onGenericMotionEvent(event);
        }

        private void openPendingUrl() {
            int length = nativePendingUrlLength(handle);
            if (length < 0) return;
            byte[] bytes = new byte[length];
            for (int i = 0; i < length; ++i) {
                int value = nativePendingUrlByte(handle, i);
                if (value < 0) {
                    nativeClearPendingUrl(handle);
                    return;
                }
                bytes[i] = (byte)value;
            }
            int mode = nativePendingUrlMode(handle);
            nativeClearPendingUrl(handle);

            try {
                Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(new String(bytes, StandardCharsets.UTF_8)));
                if (mode == 0) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_DOCUMENT);
                getContext().startActivity(intent);
            } catch (RuntimeException ignored) {
                // No activity accepted the URI, or the URI was malformed.
            }
        }

        private String pendingNotificationField(int field) {
            int length = nativePendingNotificationLength(handle, field);
            if (length < 0) return null;
            byte[] bytes = new byte[length];
            for (int i = 0; i < length; ++i) {
                int value = nativePendingNotificationByte(handle, field, i);
                if (value < 0) return null;
                bytes[i] = (byte)value;
            }
            return new String(bytes, StandardCharsets.UTF_8);
        }

        private void drainPlatformRequests() {
            openPendingUrl();
            drainClipboard();
            String id = pendingNotificationField(0);
            if (id != null) {
                String title = pendingNotificationField(1);
                String body = pendingNotificationField(2);
                nativeClearPendingNotification(handle);
                if (title != null && body != null) {
                    Intent launch = new Intent(getContext(), MainActivity.class)
                            .addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP);
                    PendingIntent pending = PendingIntent.getActivity(getContext(), 0, launch,
                            PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
                    Notification.Builder builder = Build.VERSION.SDK_INT >= 26
                            ? new Notification.Builder(getContext(), NOTIFICATION_CHANNEL_ID)
                            : new Notification.Builder(getContext());
                    builder.setSmallIcon(android.R.drawable.ic_dialog_info)
                            .setContentTitle(title).setContentText(body)
                            .setContentIntent(pending).setAutoCancel(true);
                    try {
                        getContext().getSystemService(NotificationManager.class).notify(id.hashCode(), builder.build());
                    } catch (SecurityException ignored) {}
                }
            }
            if (nativeTakeNotificationPermissionRequest(handle) != 0) {
                if (Build.VERSION.SDK_INT >= 33) {
                    ((Activity)getContext()).requestPermissions(new String[]{"android.permission.POST_NOTIFICATIONS"}, 71);
                } else {
                    nativeNotificationPermission(handle, 0);
                }
            }
            int acceptLength = nativePendingFilePickerLength(handle);
            if (acceptLength >= 0) {
                byte[] bytes = new byte[acceptLength];
                boolean valid = true;
                for (int i = 0; i < acceptLength; ++i) {
                    int value = nativePendingFilePickerByte(handle, i);
                    if (value < 0) { valid = false; break; }
                    bytes[i] = (byte)value;
                }
                nativeStartFilePicker(handle);
                if (!valid) {
                    nativeFinishFilePicker(handle, 2);
                } else {
                    Intent picker = new Intent(Intent.ACTION_OPEN_DOCUMENT)
                            .addCategory(Intent.CATEGORY_OPENABLE).setType("*/*");
                    String accept = new String(bytes, StandardCharsets.UTF_8);
                    if (!accept.isEmpty()) {
                        String[] choices = java.util.Arrays.stream(accept.split(","))
                                .map(String::trim).filter(s -> s.contains("/")).toArray(String[]::new);
                        if (choices.length == 1) picker.setType(choices[0]);
                        else if (choices.length > 1) picker.putExtra(Intent.EXTRA_MIME_TYPES, choices);
                    }
                    try { ((Activity)getContext()).startActivityForResult(picker, 72); }
                    catch (RuntimeException ignored) { nativeFinishFilePicker(handle, 2); }
                }
            }
        }

        private void drainClipboard() {
            int writeLength = nativePendingClipboardWriteLength(handle);
            if (writeLength >= 0) {
                byte[] bytes = new byte[writeLength];
                boolean valid = true;
                for (int i = 0; i < writeLength; ++i) {
                    int value = nativePendingClipboardWriteByte(handle, i);
                    if (value < 0) { valid = false; break; }
                    bytes[i] = (byte)value;
                }
                nativeClearClipboardWrite(handle);
                if (valid) {
                    try {
                        ClipboardManager clipboard = (ClipboardManager)getContext().getSystemService(Context.CLIPBOARD_SERVICE);
                        clipboard.setPrimaryClip(ClipData.newPlainText("text", new String(bytes, StandardCharsets.UTF_8)));
                    } catch (RuntimeException ignored) {}
                }
            }

            if (nativeTakeClipboardRead(handle) == 0) return;
            try {
                ClipboardManager clipboard = (ClipboardManager)getContext().getSystemService(Context.CLIPBOARD_SERVICE);
                ClipData clip = clipboard.getPrimaryClip();
                if (clip == null || clip.getItemCount() == 0) {
                    nativeFinishClipboardRead(handle, 0);
                    return;
                }
                CharSequence value = clip.getItemAt(0).coerceToText(getContext());
                if (value == null) {
                    nativeFinishClipboardRead(handle, 0);
                    return;
                }
                byte[] bytes = value.toString().getBytes(StandardCharsets.UTF_8);
                if (nativeBeginClipboardResult(handle, bytes.length) == 0) {
                    nativeFinishClipboardRead(handle, 0);
                    return;
                }
                for (int i = 0; i < bytes.length; ++i) {
                    nativeClipboardResultByte(handle, i, bytes[i] & 0xff);
                }
                nativeFinishClipboardRead(handle, 1);
            } catch (RuntimeException ignored) {
                nativeFinishClipboardRead(handle, 0);
            }
        }

        private void deliverFile(String name, String type, byte[] data) {
            byte[] nameBytes = name.getBytes(StandardCharsets.UTF_8);
            byte[] typeBytes = type.getBytes(StandardCharsets.UTF_8);
            if (nativeBeginFilePickerResult(handle, nameBytes.length, typeBytes.length, data.length) == 0) {
                nativeFinishFilePicker(handle, 2);
                return;
            }
            byte[][] fields = new byte[][]{nameBytes, typeBytes, data};
            for (int field = 0; field < fields.length; ++field) {
                for (int i = 0; i < fields[field].length; ++i) {
                    nativeFilePickerResultByte(handle, field, i, fields[field][i] & 0xff);
                }
            }
            nativeFinishFilePicker(handle, 0);
        }


        private void updateIme(boolean enabled) {
            if (imeEnabled == enabled) return;
            imeEnabled = enabled;
            InputMethodManager imm = (InputMethodManager)getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
            if (enabled) {
                requestFocus();
                restartInput();
                imm.showSoftInput(this, InputMethodManager.SHOW_IMPLICIT);
            } else {
                imm.hideSoftInputFromWindow(getWindowToken(), 0);
            }
        }

        private void restartInput() {
            InputMethodManager imm = (InputMethodManager)getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
            imm.restartInput(this);
        }

        @Override public boolean onCheckIsTextEditor() { return imeEnabled; }

        @Override public InputConnection onCreateInputConnection(EditorInfo attrs) {
            if (!imeEnabled) return null;
            attrs.inputType = InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_SENTENCES;
            attrs.imeOptions = EditorInfo.IME_ACTION_DONE | EditorInfo.IME_FLAG_NO_EXTRACT_UI;
            return new BaseInputConnection(this, false) {
                @Override public boolean commitText(CharSequence text, int newCursorPosition) {
                    text.codePoints().forEach(cp -> nativeCommitCodepoint(handle, cp));
                    scheduleFrame();
                    return super.commitText(text, newCursorPosition);
                }

                @Override public boolean setComposingText(CharSequence text, int newCursorPosition) {
                    nativeBeginPreedit(handle);
                    text.codePoints().forEach(cp -> nativeAppendPreeditCodepoint(handle, cp));
                    nativeEndPreedit(handle);
                    scheduleFrame();
                    return super.setComposingText(text, newCursorPosition);
                }

                @Override public boolean finishComposingText() {
                    nativeFinishPreedit(handle);
                    scheduleFrame();
                    return super.finishComposingText();
                }

                @Override public boolean deleteSurroundingText(int beforeLength, int afterLength) {
                    if (beforeLength > 0) nativeDeleteFromIme(handle, 1);
                    if (afterLength > 0) nativeDeleteFromIme(handle, 0);
                    scheduleFrame();
                    return super.deleteSurroundingText(beforeLength, afterLength);
                }

                @Override public boolean sendKeyEvent(KeyEvent event) {
                    if (event.getAction() == KeyEvent.ACTION_DOWN && event.getKeyCode() == KeyEvent.KEYCODE_DEL) {
                        nativeDeleteFromIme(handle, 1);
                        scheduleFrame();
                        return true;
                    }
                    return super.sendKeyEvent(event);
                }

                @Override public boolean performEditorAction(int actionCode) {
                    nativeImeAction(handle, actionCode);
                    scheduleFrame();
                    return true;
                }
            };
        }

        @Override public boolean performClick() {
            super.performClick();
            return true;
        }

        @Override protected void onDetachedFromWindow() {
            surfaceAttached = false;
            if (frameScheduled) Choreographer.getInstance().removeFrameCallback(this);
            frameScheduled = false;
            if (handle != 0) { nativeDestroy(handle); handle = 0; }
            super.onDetachedFromWindow();
        }
    }
}
